{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "settings",
  "description": "Full access for the settings window",
  "windows": [
    "settings"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-close",
    "core:window:allow-toggle-maximize",
    "allow-list-entries",
    "allow-get-display",
    "allow-widget-resize",
    "allow-widget-done",
    "allow-open-settings",
    "allow-refresh-all",
    "allow-save-entry",
    "allow-delete-entry",
    "allow-reorder-entries",
    "allow-list-groups",
    "allow-save-group",
    "allow-delete-group",
    "allow-list-alerts",
    "allow-save-alert",
    "allow-delete-alert",
    "allow-test-source",
    "allow-fetch-favicon",
    "allow-entry-history",
    "allow-simulate-change",
    "allow-keyring-available",
    "allow-has-secrets",
    "allow-save-display",
    "allow-platform-info",
    "allow-quit-app",
    "allow-list-monitors",
    "allow-weekly-recap",
    "allow-show-recap",
    "allow-save-snapshot",
    "allow-export-csv"
  ]
}
