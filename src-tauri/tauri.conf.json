{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cownter",
  "version": "0.2.5",
  "identifier": "app.cownter.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "macOSPrivateApi": true,
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost; media-src 'self' data: blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Keep the numbers you care about always in view",
    "longDescription": "Cownter polls API endpoints that return numbers (subscribers, orders, revenue, stars, any custom URL) and shows them in a tiny always-on-screen widget with history, alerts, goals and formulas.",
    "copyright": "Copyright (c) 2026 Cownter contributors. MIT License.",
    "icon": [
      "../assets/icons/32x32.png",
      "../assets/icons/128x128.png",
      "../assets/icons/256x256.png",
      "../assets/icons/icon.icns",
      "../assets/icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libayatana-appindicator3-1"
        ]
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgzQUJDRUJFNzBBMDUzMzMKUldRelU2Qnd2czZyZzNLV1laeUtXUVRzUDU2dmhiOVNPZWFMNFI2eWE0dW1EZytjbzY5ZVZ4Y1kK",
      "endpoints": [
        "https://github.com/911RS/cownter/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
